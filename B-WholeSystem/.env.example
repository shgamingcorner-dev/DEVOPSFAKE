# Smart Fire Alert — environment variables
# Copy this file to `.env` and fill in your real values.
# DO NOT commit `.env` (it is gitignored). Only this `.env.example` is pushed.

# Telegram Bot API (create a bot with @BotFather to get a token)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Telegram chat id of the house owner / group to notify
TELEGRAM_CHAT_ID=123456789

# ThingSpeak channel (Write API Key, from Channels -> API Keys)
THINGSPEAK_API_KEY=XXXXXXXXXXXXXXXX
